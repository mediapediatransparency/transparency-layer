    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-3",
   "section": "History",
   "text": "Musin was a specialist in financial intelligence who worked at Moscow State University and at the .",
   "words": 16,
   "authors": [
    "Editor 2",
    "Editor 1"
   ],
   "author_words": [
    14,
    2
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 607761274,
   "revisions": [
    607761274,
    1032071028
   ],
   "revision_words": [
    14,
    2
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-4",
   "section": "History",
   "text": "The agency takes a pro-Kremlin position, and is part of a wider network of outlets that amplifies Russian propaganda.",
   "words": 20,
   "authors": [
    "Editor 6",
    "Editor 14"
   ],
   "author_words": [
    18,
    2
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 921413577,
   "revisions": [
    921413577,
    819531070
   ],
   "revision_words": [
    18,
    2
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-5",
   "section": "History",
   "text": "ANNA publishes in the Russian language and is known for being \"a voracious purveyor of insider YouTube footage of the Syrian civil war since 2012\"; ANNA embedded with the Syrian Arab Army in their operations against rebels.",
   "words": 37,
   "authors": [
    "Editor 2",
    "Editor 6",
    "Editor 4",
    "Editor 7",
    "Editor 11",
    "Editor 16"
   ],
   "author_words": [
    18,
    15,
    1,
    1,
    1,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 607761274,
   "revisions": [
    607761274,
    921413577,
    616034037,
    626106601,
    793847001,
    1045449555
   ],
   "revision_words": [
    18,
    15,
    1,
    1,
    1,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-6",
   "section": "History",
   "text": "It has been known for publishing footage recorded directly from Syrian Army tanks.",
   "words": 13,
   "authors": [
    "Editor 7"
   ],
   "author_words": [
    13
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 616259215,
   "revisions": [
    616259215
   ],
   "revision_words": [
    13
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-7",
   "section": "History",
   "text": "In January 2013, a Russian judge and a former military intelligence officer Sergey Berezhnoy survived being shot while accompanying ANNA crew in the Damascus suburb of Darayya, Syria.",
   "words": 28,
   "authors": [
    "Editor 2",
    "Editor 1",
    "Editor 6"
   ],
   "author_words": [
    18,
    9,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 607761274,
   "revisions": [
    607761274,
    1032050252,
    607761791,
    921413577
   ],
   "revision_words": [
    16,
    9,
    2,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-8",
   "section": "History",
   "text": "Berezhnoy said that he participated in the coverage of the military operation in Syria as a writer.",
   "words": 17,
   "authors": [
    "Editor 3",
    "Editor 1"
   ],
   "author_words": [
    15,
    2
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1044313640,
   "revisions": [
    1044313640,
    1044350630
   ],
   "revision_words": [
    15,
    2
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-9",
   "section": "History",
   "text": "According to a 2018 publication from the Moscow Psychological and Social University, ANNA News works with officers of the information confrontation group of the Russian Reconciliation Center for Syria.",
   "words": 29,
   "authors": [
    "Editor 1",
    "Editor 5"
   ],
   "author_words": [
    17,
    12
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1045937345,
   "revisions": [
    1045937345,
    1047434167
   ],
   "revision_words": [
    17,
    12
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-10",
   "section": "History",
   "text": "ANNA journalists were also embedded with Russian-backed separatists fighting the Government of Ukraine since 2014.",
   "words": 16,
   "authors": [
    "Editor 4"
   ],
   "author_words": [
    16
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1045774783,
   "revisions": [
    1045774783
   ],
   "revision_words": [
    16
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-11",
   "section": "History",
   "text": "In May 2020, ANNA News was banned from YouTube for violating its terms of service.",
   "words": 15,
   "authors": [
    "Editor 8",
    "Editor 4"
   ],
   "author_words": [
    13,
    2
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 957928255,
   "revisions": [
    957928255,
    1045450902,
    957928284
   ],
   "revision_words": [
    12,
    2,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-12",
   "section": "History",
   "text": "It was revealed that employees of ANNA also worked for Russian propaganda websites NewsFront and SouthFront, and that NewsFront had raised money for ANNA in 2014.",
   "words": 26,
   "authors": [
    "Editor 4",
    "Editor 1",
    "Editor 13"
   ],
   "author_words": [
    14,
    9,
    3
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1045774783,
   "revisions": [
    1045774783,
    1032051593,
    1045450902,
    1076151631,
    1075882446
   ],
   "revision_words": [
    10,
    9,
    4,
    2,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-13",
   "section": "History",
   "text": "Both ANNA News and SouthFront support separatist forces in Ukraine.",
   "words": 10,
   "authors": [
    "Editor 1",
    "Editor 3"
   ],
   "author_words": [
    9,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1044362074,
   "revisions": [
    1044362074,
    1044466055
   ],
   "revision_words": [
    9,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-14",
   "section": "History",
   "text": "In August 2021, president of Ukraine Volodymyr Zelenskyy, based on the decision of the National Security and Defence Council, signed a decree \"on the application of personal special economic and other restrictive measures\" against ANNA News.",
   "words": 36,
   "authors": [
    "Editor 1",
    "Editor 18"
   ],
   "author_words": [
    35,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1044376134,
   "revisions": [
    1044376134,
    1161245771
   ],
   "revision_words": [
    35,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-15",
   "section": "History",
   "text": "The decision ordered the web resources of the news agency to be blocked.",
   "words": 13,
   "authors": [
    "Editor 1",
    "Editor 4"
   ],
   "author_words": [
    9,
    4
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1044376134,
   "revisions": [
    1044376134,
    1045450902,
    1044376450
   ],
   "revision_words": [
    8,
    4,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-1",
   "section": "Content",
   "text": "According to U.S. intelligence officer T. S. Allen, Pascal Andresen and the Ukrainian magazine Political Life, it is engaged in influence operations and is a propaganda tool.",
   "words": 28,
   "authors": [
    "Editor 5",
    "Editor 1",
    "Editor 4"
   ],
   "author_words": [
    17,
    10,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1047013300,
   "revisions": [
    1047013300,
    1004326933,
    1032051841,
    1045446881,
    1047014093
   ],
   "revision_words": [
    16,
    9,
    1,
    1,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-2",
   "section": "Content",
   "text": "According to The Moscow Times newspaper, it has a 'forceful pro-Assad slant.'",
   "words": 13,
   "authors": [
    "Editor 2",
    "Editor 1",
    "Editor 17"
   ],
   "author_words": [
    11,
    1,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 607761274,
   "revisions": [
    607761274,
    853871245,
    1050369104
   ],
   "revision_words": [
    11,
    1,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-3",
   "section": "Content",
   "text": "Professor of Arabic language and civilisation Stéphane Valter writes that the way the news agency diffuse their images \"clearly indicates a bias in favour of the Syrian regime.\"",
   "words": 28,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    28
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1045944819,
   "revisions": [
    1045944819
   ],
   "revision_words": [
    28
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-4",
   "section": "Content",
   "text": "In June 2014, ANNA News falsely claimed that political advisor Jen Psaki had been fired from the US State Department.",
   "words": 20,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    20
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1004328771,
   "revisions": [
    1004328771
   ],
   "revision_words": [
    20
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-5",
   "section": "Content",
   "text": "In the fall of 2014, the agency published a fake photo of several dead people who were allegedly killed by the Ukrainian authorities.",
   "words": 23,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    23
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1045933427,
   "revisions": [
    1045933427
   ],
   "revision_words": [
    23
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-6",
   "section": "Content",
   "text": "On 5 January 2017, ANNA News falsely claimed that the jihadist organisation Al-Nusra Front, which fought against the Syrian authorities, calls the White Helmets volunteer organisation \"soldiers of the revolution\".",
   "words": 31,
   "authors": [
    "Editor 1",
    "Editor 15"
   ],
   "author_words": [
    30,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1045971314,
   "revisions": [
    1045971314,
    1171043767
   ],
   "revision_words": [
    30,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-7",
   "section": "Content",
   "text": "In February 2017, ANNA News claimed that Ukraine was the source of a leak of radioactive iodine-131.",
   "words": 18,
   "authors": [
    "Editor 1",
    "Editor 4"
   ],
   "author_words": [
    17,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1044369862,
   "revisions": [
    1044369862,
    1045774783
   ],
   "revision_words": [
    17,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-8",
   "section": "Content",
   "text": "The news agency did not provide any evidence.",
   "words": 8,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    8
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1044369862,
   "revisions": [
    1044369862
   ],
   "revision_words": [
    8
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-9",
   "section": "Content",
   "text": "In late 2017, ANNA News journalist Oleg Blokhin based in Syria created staged photos to substantiate the existence of a fake private military company Turan.",
   "words": 25,
   "authors": [
    "Editor 1",
    "Editor 4"
   ],
   "author_words": [
    19,
    6
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1032077405,
   "revisions": [
    1032077405,
    1045450215,
    1045774783,
    1032082050
   ],
   "revision_words": [
    18,
    3,
    3,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-10",
   "section": "Content",
   "text": "After it was discovered that the photos were fake, ANNA removed all of Blokhin materials from its website.",
   "words": 18,
   "authors": [
    "Editor 1",
    "Editor 3"
   ],
   "author_words": [
    16,
    2
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1032077405,
   "revisions": [
    1032077405,
    1045422139
   ],
   "revision_words": [
    16,
    2
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-11",
   "section": "Content",
   "text": "Oleg Blokhin categorically rejected the claims of Russian research group Conflict Intelligence Team that the PMC Turan, fighting in Syria, is a fiction created by him.",
   "words": 26,
   "authors": [
    "Editor 3"
   ],
   "author_words": [
    26
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1045422139,
   "revisions": [
    1045422139
   ],
   "revision_words": [
    26
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-12",
   "section": "Content",
