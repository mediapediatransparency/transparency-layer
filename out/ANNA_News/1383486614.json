  {
   "id": "sec1-1",
   "section": "History",
   "text": "ANNA News was officially registered as mass media in Abkhazia on 18 July 2011 after the events of the Abkhaz–Georgian conflict.",
   "words": 22,
   "authors": [
    "Editor 2",
    "Editor 1",
    "Editor 11"
   ],
   "author_words": [
    11,
    9,
    2
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 607761274,
   "revisions": [
    607761274,
    1047553533,
    626107059
   ],
   "revision_words": [
    11,
