    2
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-2",
   "section": "History",
   "text": "It was founded and managed by Marat Musin until his death in May 2018.",
   "words": 14,
   "authors": [
    "Editor 1",
    "Editor 9",
    "Editor 2"
   ],
   "author_words": [
    5,
    5,
    4
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 840242462,
   "revisions": [
    840242462,
    607761274,
    1032071028,
    1004320501
   ],
   "revision_words": [
    5,
    4,
