   }
  },
  {
   "id": "sec1-11",
   "section": "History",
   "text": "Modern science, however, rejects this possibility for both linguistic and historical reasons.",
   "words": 12,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    12
   ],
