   }
  },
  {
   "id": "sec1-9",
   "section": "History",
   "text": "This assumption was also expressed by the British historian Richard David Barnett, but later rejected due to the emergence of new data.",
   "words": 22,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    22
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1057897866,
