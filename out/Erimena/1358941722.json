   }
  },
  {
   "id": "sec1-10",
   "section": "History",
   "text": "This assumption, combined with folk legends, gave rise to the opinion that from 620 BC, the Armenian dynasty already ruled in Urartu.",
   "words": 22,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    22
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
