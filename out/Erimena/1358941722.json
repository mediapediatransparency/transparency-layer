    "in_place_since": "2021-11-30",
    "in_place_since_revision": 1057897866,
    "removals": []
   }
  },
  {
   "id": "sec1-7",
   "section": "History",
   "text": "Modern science does not have sufficient information to unambiguously resolve these issues.",
   "words": 12,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    12
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
