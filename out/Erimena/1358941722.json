   }
  },
  {
   "id": "lead-3",
   "section": "(lead)",
   "text": "Erimena, according to a Babylonian chronicle, held an expedition in the mountainous region of Bit Hanounia, under the rule of Nabopolassar.",
   "words": 21,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    21
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1057897866,
   "revisions": [
