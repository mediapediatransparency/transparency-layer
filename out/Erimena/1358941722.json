  {
   "id": "lead-2",
   "section": "(lead)",
   "text": "He was the successor of Sarduri III and father of Rusa III, who ruled Urartu from 610-590 B.C. Little is known about Erimena; his name was mentioned in an inscribed bronze shield found at Toprakkale by Hormuzd Rassam in 1880 that is now located in the British Museum.",
   "words": 50,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    50
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1057897866,
   "revisions": [
    1057897866
   ],
   "revision_words": [
    50
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0,
   "footnotes": 2,
   "works_cited": 2,
   "history": {
    "removed": 0,
    "back_within_24h": 0,
