      3.6
     ]
    ]
   }
  },
  {
   "id": "sec1-2",
   "section": "Background",
   "text": "According to the nurses, Henderson had at some point stopped taking her hormone medication in order to be able to get her girlfriend pregnant, thus making her \"a sexually active biological male\"; and they had submitted a group complaint letter to their bosses alleging such.",
   "words": 45,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    45
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1318260292,
   "revisions": [
    1318260292,
    1318407280,
    1318407823
   ],
   "revision_words": [
    29,
    13,
    3
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0,
   "footnotes": 1,
   "works_cited": 1,
   "history": {
    "removed": 0,
    "back_within_24h": 0,
    "out_24h_or_more": 0,
    "removing_accounts": 0,
    "restoring_accounts": 0,
    "page_wide_removals": 0,
    "first_added": "2025-10-22",
    "latest_removal": null,
    "in_place_since": "2025-10-22",
    "in_place_since_revision": 1318260292,
    "removals": []
   }
  },
  {
   "id": "sec1-3",
   "section": "Background",
   "text": "Henderson denies that she ever stopped her hormone therapy, saying that she had only ever mentioned the abstract possibility of getting her girlfriend pregnant during a theoretical discussion with colleagues.",
   "words": 30,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    30
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1318260292,
   "revisions": [
