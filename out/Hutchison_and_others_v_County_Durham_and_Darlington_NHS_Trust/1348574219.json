    "removals": []
   }
  },
  {
   "id": "sec1-4",
   "section": "Background",
   "text": "Beth Hutchison, the nurse leading the case, said that she found anything Henderson said difficult to believe given that she was \"a man pretending to be a woman\".",
   "words": 28,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    28
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
