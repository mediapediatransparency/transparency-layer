  {
   "id": "sec1-1",
   "section": "Background",
   "text": "The case centered around transgender woman Rose Henderson using the women's changing room since 2019, although beyond that the facts of the case were vastly disputed.",
   "words": 27,
   "authors": [
    "Editor 1",
    "Editor 5"
   ],
   "author_words": [
    23,
    4
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1318260292,
   "revisions": [
    1318260292,
    1333372963
   ],
   "revision_words": [
    23,
    4
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0,
   "footnotes": 2,
   "works_cited": 2,
   "history": {
    "removed": 2,
    "back_within_24h": 2,
    "out_24h_or_more": 0,
    "removing_accounts": 2,
    "restoring_accounts": 1,
    "page_wide_removals": 0,
    "first_added": "2025-10-22",
    "latest_removal": "2026-01-20",
    "in_place_since": "2026-01-20",
    "in_place_since_revision": 1333955110,
    "removals": [
     [
      1333904705,
      1333912011,
      1.4
     ],
     [
      1333927183,
