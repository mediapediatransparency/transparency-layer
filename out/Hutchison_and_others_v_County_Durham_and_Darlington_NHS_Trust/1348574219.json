   }
  },
  {
   "id": "sec2-1",
   "section": "Incident",
   "text": "According to Danson, in September 2023 she had walked past Henderson in the changing room without paying much attention, until she'd heard Henderson speak in a \"male voice\" and turned to see Henderson in her underwear, midway through getting changed.",
   "words": 41,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    41
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1318260292,
   "revisions": [
    1318260292
   ],
   "revision_words": [
    41
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0,
   "footnotes": 1,
   "works_cited": 1,
   "history": {
    "removed": 0,
    "back_within_24h": 0,
    "out_24h_or_more": 0,
    "removing_accounts": 0,
    "restoring_accounts": 0,
    "page_wide_removals": 0,
