   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-8",
   "section": "History",
   "text": "In addition to the Hamaas article the British government published intercepted telegrams between the Jewish Agency in Jerusalem and Zionist leaders in London that demonstrated Jewish Agency control over the formal organisation established by the Haganah, Irgun and Lehi to coordinate their actions, which was known as the Tenuat Hameri (United Resistance Movement).",
   "words": 53,
