   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-6",
   "section": "Osama Siblani",
   "text": "After a sign was placed in honor of Siblani in Dearborn in 2025, a local pastor raised concerns over the appropriateness of the move, as Siblani seemed to support Hezbollah, to Dearborn Mayor Abdullah Hammoud at a City Council meeting.",
