   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-3",
   "section": "Osama Siblani",
   "text": "He is the first to be inducted from an ethnic media outlet, and the second Arab American, after the induction of White House correspondent Helen Thomas in 1993.",
   "words": 28,
   "authors": [
    "Editor 2",
    "Editor 9"
   ],
   "author_words": [
    25,
    3
   ],
   "author_sanctioned": false,
