  {
   "id": "sec1-2",
   "section": "Osama Siblani",
   "text": "Siblani was inducted into the Michigan Journalism Hall of Fame in April 2013.",
   "words": 13,
   "authors": [
    "Editor 2"
   ],
   "author_words": [
    13
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 859998670,
   "revisions": [
    859998670
