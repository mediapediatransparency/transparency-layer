   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-5",
   "section": "Osama Siblani",
   "text": "At an October 2024 rally, Siblani praised the then-leader of Lebanese Islamist movement and militant group, designated by the U.S. as a terrorist organization, Hezbollah, Hassan Nasrallah as a \"great leader\", and expounded on the statement about evacuated Israelis, framing it as an argument involving indigeneity based on the familial ancestry of Israeli Prime Minister Benjamin Netanyahu.",
   "words": 59,
   "authors": [
    "Editor 3",
    "Editor 1"
   ],
   "author_words": [
    47,
    12
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1382908193,
