  },
  {
   "id": "sec1-4",
   "section": "Osama Siblani",
   "text": "At a September 2024 rally in Dearborn, Michigan in opposition to the September 2024 Israeli attacks against Lebanon, Siblani called to prevent the Israelis that were evacuated during the Israel–Hezbollah conflict from returning to their homes and expel them to Poland, as well as for the destruction of the state of Israel.",
   "words": 53,
   "authors": [
    "Editor 1",
    "Editor 3"
   ],
   "author_words": [
    32,
    21
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1301352063,
   "revisions": [
    1301352063,
    1320905621,
    1382908193,
    1382919082,
    1382919382,
    1382909769
   ],
   "revision_words": [
