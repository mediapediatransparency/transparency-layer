   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-6",
   "section": "Career",
   "text": "In October 2024, Lilly Wachowski announced that she is adapting Manhunt into a TV series with Felker-Martin.",
   "words": 18,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    18
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
