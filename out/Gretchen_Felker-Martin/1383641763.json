  {
   "id": "sec2-2",
   "section": "Career",
   "text": "Felker-Martin's science fiction horror novel Manhunt was published on February 22, 2022, in the U.S. by Tor Nightfire.",
   "words": 21,
   "authors": [
    "Editor 1",
    "Editor 10",
    "Editor 17"
   ],
   "author_words": [
    19,
    1,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1252236105,
   "revisions": [
    1252236105,
    1252459995,
    1330783952
   ],
   "revision_words": [
    19,
    1,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-3",
   "section": "Career",
   "text": "Manhunt appeared on best-of-year lists in multiple publications, including appearing at No. 1 in Vultures list of \"The Best Books of 2022\".",
   "words": 25,
   "authors": [
    "Editor 1",
    "Editor 14"
   ],
   "author_words": [
    24,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1252236105,
   "revisions": [
    1252236105,
    1312097277,
    1330510682
   ],
   "revision_words": [
    23,
    1,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-4",
   "section": "Career",
   "text": "Roxane Gay selected it as one of the \"25 Most Influential Works of Postwar Queer Literature\", writing, \"This is the kind of book that queer writers have been desperate to write forever and are rarely given the opportunity to\".",
   "words": 39,
   "authors": [
    "Editor 1",
    "Editor 10"
   ],
   "author_words": [
    38,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1252236105,
   "revisions": [
    1252236105,
    1252459995
   ],
   "revision_words": [
