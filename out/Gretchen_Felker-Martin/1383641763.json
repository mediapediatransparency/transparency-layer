   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-8",
   "section": "Career",
   "text": "In its first week it entered the USA Today best-seller list, and it was chosen as one of the \"Best Horror Books of 2024 (So Far)\" by Vulture.",
   "words": 29,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    29
   ],
   "author_sanctioned": false,
