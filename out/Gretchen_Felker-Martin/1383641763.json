   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-9",
   "section": "Career",
   "text": "Publishers Weekly wrote, \"Laying bare grief, terror, and the tenderness that makes it all matter, this is horror at its best.\"",
   "words": 21,
   "authors": [
    "Editor 1",
    "Editor 10"
