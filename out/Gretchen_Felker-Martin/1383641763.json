    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-5",
   "section": "Career",
   "text": "The Los Angeles Review of Books wrote, \"Felker-Martin's horror novel cunningly weaves trans determinism, war, and trauma together in an effort to locate joy, empathy, and pleasure in a world on fire.\"",
   "words": 34,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    34
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1252236105,
