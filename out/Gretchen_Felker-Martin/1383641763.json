   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-7",
   "section": "Career",
   "text": "Her novel Cuckoo was published on June 11, 2024.",
   "words": 9,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    9
   ],
   "author_sanctioned": false,
