    "removals": []
   }
  },
  {
   "id": "sec1-2",
   "section": "Anti-imperialism and pan-Islamism",
   "text": "PIJ view the Israeli state as both an occupying power and a colonial power which must be dismantled.",
   "words": 18,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    18
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1121295900,
   "revisions": [
    1121295900
   ],
   "revision_words": [
    18
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0,
   "footnotes": 1,
   "works_cited": 1,
   "history": {
    "removed": 0,
    "back_within_24h": 0,
    "out_24h_or_more": 0,
    "removing_accounts": 0,
    "restoring_accounts": 0,
    "page_wide_removals": 0,
    "first_added": "2022-11-11",
    "latest_removal": null,
    "in_place_since": "2022-11-11",
    "in_place_since_revision": 1121295900,
    "removals": []
   }
  },
  {
   "id": "sec1-3",
   "section": "Anti-imperialism and pan-Islamism",
   "text": "They believe that the Arab–Israeli conflict has its roots not in 1948 and the emergence of the Israeli state, but rather in Western imperialism and its destructive effect on Islamic unity.",
   "words": 32,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    32
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1121295900,
   "revisions": [
    1121295900
   ],
   "revision_words": [
    32
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0,
   "footnotes": 1,
   "works_cited": 1,
   "history": {
    "removed": 0,
    "back_within_24h": 0,
    "out_24h_or_more": 0,
    "removing_accounts": 0,
    "restoring_accounts": 0,
    "page_wide_removals": 0,
