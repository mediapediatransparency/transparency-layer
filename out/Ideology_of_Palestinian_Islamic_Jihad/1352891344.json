    "in_place_since": "2022-11-11",
    "in_place_since_revision": 1121295900,
    "removals": []
   }
  },
  {
   "id": "sec1-4",
   "section": "Anti-imperialism and pan-Islamism",
   "text": "More specifically, PIJ believe that Western powers aimed to divide Islamic societies and communities to upkeep Western hegemony in the region after the dissolution of the Ottoman Empire.",
   "words": 28,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    28
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1121295900,
   "revisions": [
    1121295900
   ],
   "revision_words": [
    28
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0,
   "footnotes": 2,
   "works_cited": 2,
   "history": {
    "removed": 0,
    "back_within_24h": 0,
    "out_24h_or_more": 0,
    "removing_accounts": 0,
    "restoring_accounts": 0,
    "page_wide_removals": 0,
