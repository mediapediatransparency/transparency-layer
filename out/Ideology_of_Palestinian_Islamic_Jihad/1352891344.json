   }
  },
  {
   "id": "sec1-8",
   "section": "Anti-imperialism and pan-Islamism",
   "text": "In line with their belief in the importance of Muslim unity, PIJ emphasise the commonalities of Shia Islam and Sunni Islam, rather than their differences.",
   "words": 25,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    25
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
