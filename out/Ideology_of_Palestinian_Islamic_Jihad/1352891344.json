  {
   "id": "sec1-1",
   "section": "Anti-imperialism and pan-Islamism",
   "text": "PIJ’s ideology is influenced by both anti-imperialism and pan-Islamism, amongst other things.",
   "words": 15,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    15
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
