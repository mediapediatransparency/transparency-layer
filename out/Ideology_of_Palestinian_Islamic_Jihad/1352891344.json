    "removals": []
   }
  },
  {
   "id": "sec1-5",
   "section": "Anti-imperialism and pan-Islamism",
   "text": "PIJ view the Israeli state as an extension and mechanism of Western hegemony, contributing to the oppression of the local population and constituting a major cause of division, conflict and instability in the region and the Global South more generally.",
   "words": 40,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    40
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1121295900,
   "revisions": [
    1121295900
   ],
   "revision_words": [
    40
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0,
   "footnotes": 2,
   "works_cited": 2,
   "history": {
    "removed": 0,
    "back_within_24h": 0,
