  },
  {
   "id": "sec1-10",
   "section": "Anti-imperialism and pan-Islamism",
   "text": "Alavi argues that Shaqaqi’s ideas regarding the importance of Islamic movements and Islamic unity for freeing the region from Western domination and colonization stemmed from Khomeini.",
   "words": 27,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    27
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1121296687,
