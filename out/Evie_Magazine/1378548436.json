  {
   "id": "sec2-1",
   "section": "Content",
   "text": "Evie is an antifeminist publication.",
   "words": 5,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    5
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
