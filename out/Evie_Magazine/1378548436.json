  },
  {
   "id": "sec2-23",
   "section": "Content",
   "text": "Contributors to Evie'' include:",
   "words": 4,
   "authors": [
    "Editor 1",
    "Editor 10"
   ],
   "author_words": [
    3,
    1
   ],
