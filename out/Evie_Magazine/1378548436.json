   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-2",
   "section": "Content",
   "text": "It has been characterized as alt-right and far-right.",
   "words": 10,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    10
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1303951888,
   "revisions": [
