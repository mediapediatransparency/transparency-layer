    4
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-18",
   "section": "Content",
   "text": "Martinez has said that Evie was early in writing about topics such as criticism of hookup culture and women's hormonal health that have since entered the mainstream.",
   "words": 28,
   "authors": [
    "Editor 2"
   ],
   "author_words": [
    28
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1353368894,
   "revisions": [
    1353368894
   ],
   "revision_words": [
    28
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-19",
   "section": "Content",
   "text": "Evie publishes articles critical of both hormonal birth control and non-hormonal birth control, such as copper IUDs and condoms, and has published stories of women suffering deadly side effects such as blood clots from hormonal birth control.",
   "words": 39,
   "authors": [
    "Editor 2",
    "Editor 3",
    "Editor 13"
   ],
   "author_words": [
    33,
    5,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1353368894,
   "revisions": [
    1353368894,
    1320907214,
    1353822257
   ],
   "revision_words": [
    33,
    5,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-20",
   "section": "Content",
   "text": "Print editions of Evie include advertisements for their fertility planning app, 28, which suggests food and exercises for different stages of the user's menstrual cycle and discourages hormonal birth control.",
   "words": 31,
   "authors": [
    "Editor 2",
    "Editor 3"
   ],
   "author_words": [
    30,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1353368894,
   "revisions": [
    1353368894,
    1320907214
   ],
   "revision_words": [
    30,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-21",
   "section": "Content",
   "text": "Evie also sells birth control \"detox\" supplements through the app, with advertisements saying \"Goodbye toxicity.\"",
   "words": 15,
   "authors": [
    "Editor 2"
   ],
   "author_words": [
    15
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1353368894,
   "revisions": [
    1353368894
   ],
   "revision_words": [
    15
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-22",
   "section": "Content",
   "text": "Evie 2024 edition praised Donald Trump's nomination of anti-vaccine activist Robert F. Kennedy Jr. for Secretary of Health and Human Services, and described Dutch far-right commentator Eva Vlaardingerbroek as a \"shieldmaiden\", a term that has been co-opted by the alt-right to describe the female faces of white supremacy and conservatism.",
   "words": 55,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    55
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
