    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-8",
   "section": "Content",
   "text": "In 2023, Rolling Stone described Evie as \"a girlboss-ified Breitbart\" and reported that it uses the traditional format of women's fashion publications, including Met Gala slideshows and breakdowns of Taylor Swift's Eras tour outfits, to attract a Generation Z audience.",
   "words": 43,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    43
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
