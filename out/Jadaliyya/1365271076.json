   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-4",
   "section": "History",
   "text": "Haddad and his colleague Sinan Antoon stated that \"good knowledge was being hoarded in journals that are largely inaccessible to the general public\" and wanted \"to reach beyond the academic community.\"",
   "words": 31,
   "authors": [
    "Editor 1",
    "Editor 6"
   ],
   "author_words": [
    30,
    1
   ],
   "author_sanctioned": false,
