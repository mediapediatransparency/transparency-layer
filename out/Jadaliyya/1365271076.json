   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-6",
   "section": "History",
   "text": "In 2009, influenced by new developments in social media, Haddad revisited the project with Antoon, Sherene Seikaly, Nadya Sbaiti, Noura Erakat, and Maya Mikdashi.",
   "words": 24,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
