   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-5",
   "section": "History",
   "text": "The idea was shelved, however, after the Iraq War began in 2003 and their team focused instead on producing three documentary films in a period of six years (About Baghdad, What is Said About Arabs and Terrorism, and The Other Threat).",
   "words": 41,
   "authors": [
    "Editor 1",
    "Editor 6"
   ],
   "author_words": [
    40,
    1
   ],
   "author_sanctioned": false,
