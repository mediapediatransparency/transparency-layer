   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec3-7",
   "section": "Response",
   "text": "Moreover, Jadaliyya is the place where writing of a kind that we associate with the best of anthropology--in the moment, grounded in theory, capturing historical transformation through engagement in events as they unfold--has been published.",
   "words": 37,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    37
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
