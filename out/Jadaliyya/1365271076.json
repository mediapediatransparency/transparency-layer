   "sanctioned_words_during": 0
  },
  {
   "id": "sec4-2",
   "section": "Book",
   "text": "Composed of twenty essays originally published in Jadaliyya, the text (according to the editors) sheds \"light on the historical background and initial impact of the mass uprisings which have shaken the Arab world since December 2010 [....] while the book focuses on those states that have been most affected by the uprisings it also covers the impact on Jordan, Saudi Arabia, Lebanon, Palestine, and Iraq.\"",
   "words": 64,
   "authors": [
    "Editor 1",
    "Editor 11"
   ],
   "author_words": [
    63,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 507586318,
   "revisions": [
