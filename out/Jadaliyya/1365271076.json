   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec4-4",
   "section": "Book",
   "text": "Laleh Khalili, Senior Lecturer in Middle East Politics, SOAS, University of London suggested that The Dawn of the Arab Uprisings: End of an Old Order? is \"a very rare combination - scholarly but also accessible for a broad public.\"",
   "words": 38,
   "authors": [
    "Editor 1",
    "Editor 6"
   ],
   "author_words": [
    37,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 507586318,
