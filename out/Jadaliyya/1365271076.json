   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec4-3",
   "section": "Book",
   "text": "Timothy Mitchell, professor of Middle Eastern Studies at Columbia University, observed that \"as the work of scholars and activists with a rich knowledge of the region's histories and political aspirations, the essays offer lasting insights into the forces shaping a new moment in world history.\"",
   "words": 46,
   "authors": [
    "Editor 1",
    "Editor 6"
   ],
   "author_words": [
    45,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 517769338,
   "revisions": [
