  {
   "id": "sec1-1",
   "section": "Biography",
   "text": "Sudzilovsky was born in Mogilev to a noble family.",
   "words": 9,
   "authors": [
    "Editor 1",
    "Editor 2"
   ],
   "author_words": [
    7,
    2
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 38842607,
   "revisions": [
    38842607,
    241930618
   ],
   "revision_words": [
    7,
    2
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-2",
   "section": "Biography",
   "text": "He entered the St. Petersburg University law department but dropped out on the next year and entered medical department of the Kiev University where he did not finish his studies.",
   "words": 30,
   "authors": [
    "Editor 2",
    "Editor 1",
    "Editor 16"
   ],
   "author_words": [
    23,
    6,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 241934413,
   "revisions": [
    241934413,
    38842607,
    241936551,
    40614262
   ],
   "revision_words": [
    18,
    6,
    5,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-3",
   "section": "Biography",
   "text": "He began to get involved in political activity being one of the organisers of the Kiev commune, a left-wing student organisation in 1873–1874.",
   "words": 25,
   "authors": [
    "Editor 1",
    "Editor 2",
    "Editor 3"
   ],
   "author_words": [
    15,
    5,
    5
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 38842607,
   "revisions": [
    38842607,
    104781823,
    241936551
   ],
   "revision_words": [
    15,
    5,
    5
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-4",
   "section": "Biography",
   "text": "Getting a job of medical assistant at the Nikolayev prison, he tried to arrange mass escape of the prisoners, but his plot failed and he had to flee from Russia escaping arrest in 1875.",
   "words": 34,
   "authors": [
    "Editor 2",
    "Editor 1",
    "Editor 3"
   ],
   "author_words": [
    31,
    2,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 241936551,
   "revisions": [
