   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-6",
   "section": "Biography",
   "text": "In 1877 he graduated from medical faculty of the University of Bucharest.",
   "words": 12,
   "authors": [
    "Editor 2",
    "Editor 12",
    "Editor 13"
   ],
   "author_words": [
    6,
