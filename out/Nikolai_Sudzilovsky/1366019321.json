  },
  {
   "id": "sec1-12",
   "section": "Biography",
   "text": "In 1900 under the name Kauka Lukini, Sudzilovsky was elected Hawaii Senator, in 1901 was elected as 1st Hawaii Senate President.",
   "words": 21,
   "authors": [
    "Editor 1",
    "Editor 7",
    "Editor 2"
   ],
   "author_words": [
