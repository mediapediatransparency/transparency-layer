   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-10",
   "section": "Biography",
   "text": "In 1887, Sudzilovsky moved to San Francisco and later Hawaii, becoming an American citizen.",
   "words": 14,
   "authors": [
    "Editor 1",
    "Editor 3",
    "Editor 2"
   ],
   "author_words": [
    9,
    4,
    1
