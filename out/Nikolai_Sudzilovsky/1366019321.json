  },
  {
   "id": "sec1-13",
   "section": "Biography",
   "text": "During the Russo-Japanese War of 1904–1905 Sudzilovsky actively conducted socialist propaganda among Russian prisoners of war.",
   "words": 18,
   "authors": [
    "Editor 1",
    "Editor 3",
    "Editor 2"
   ],
   "author_words": [
