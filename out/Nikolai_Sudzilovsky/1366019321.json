  },
  {
   "id": "sec1-7",
   "section": "Biography",
   "text": "Russel was one of the organisers of the socialist movement in Romania, published a socialist paper, and carried out socialist propaganda among the Russian troops during the Russo-Turkish War.",
   "words": 30,
   "authors": [
    "Editor 2",
    "Editor 3"
   ],
   "author_words": [
    19,
    11
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 227529210,
   "revisions": [
    227529210,
    104781823
   ],
   "revision_words": [
    19,
    11
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-8",
   "section": "Biography",
   "text": "He also fought in Romania's war of independence, being distinguished with the Order of the Star of Romania.",
   "words": 19,
   "authors": [
    "Editor 5"
   ],
   "author_words": [
    19
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1067231550,
   "revisions": [
