   ],
   "revision_words": [
    19
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-9",
   "section": "Biography",
   "text": "Dr. Russel was one of the most energetic socialists during his stay in Romania from 1875 until 1881 when he was deported, at the request of the Tsarist authorities, after attempting to hold a celebration of \"The 10th Anniversary of the Paris Commune of 1871\".",
   "words": 45,
   "authors": [
    "Editor 4",
    "Editor 8",
    "Editor 9",
    "Editor 2"
   ],
   "author_words": [
