   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-11",
   "section": "Biography",
   "text": "There he became a founder of the Home Rule Party of Hawaii in 1892, which opposed Hawaii's joining the United States.",
   "words": 22,
   "authors": [
    "Editor 3",
    "Editor 1",
    "Editor 11",
    "Editor 15"
   ],
   "author_words": [
