   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-5",
   "section": "Biography",
   "text": "In 1876 under the pseudonym Nicholas Russel, Sudzilovsky took part in the Bulgarian April Uprising against the Ottoman Empire.",
   "words": 19,
   "authors": [
    "Editor 3",
    "Editor 1",
    "Editor 2"
   ],
   "author_words": [
    17,
    1,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 104781823,
