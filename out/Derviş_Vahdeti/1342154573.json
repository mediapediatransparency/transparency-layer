  },
  {
   "id": "sec1-13",
   "section": "Biography",
   "text": "Vahdeti argued that the rule of the Committee of Union and Progress would terminate the Ottoman Empire and damage Islam.",
   "words": 20,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    20
