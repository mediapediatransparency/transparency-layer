  {
   "id": "sec1-11",
   "section": "Biography",
   "text": "On 13 April 1909 a group of religious figured led by Vahdeti started a riot against the constitution and the Committee of Union and Progress, which is known as 31 March incident in reference to the Islamic date of the day, namely 31 March 1325.",
   "words": 45,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    45
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
