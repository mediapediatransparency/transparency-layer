    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-2",
   "section": "(lead)",
   "text": "The trend began in the United States in the first few decades of the 20th century when \"an increasingly large section of Americanized Jewish opinion began to shift away from anti-Zionism... either to pro-Zionism or non-Zionism....",
   "words": 39,
   "authors": [
    "Editor 2",
    "Editor 6",
    "Editor 15"
   ],
   "author_words": [
    25,
    13,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 208484266,
   "revisions": [
    208484266,
    208486118,
    220673112
   ],
   "revision_words": [
    25,
    13,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-3",
   "section": "(lead)",
   "text": "The non-Zionists were willing to offer the diaspora Jews a Jewish homeland fiscal and diplomatic counsel, not for their own benefit or spiritual comfort but for those Jews who chose to reside there.\"",
   "words": 34,
   "authors": [
    "Editor 2",
    "Editor 7"
   ],
   "author_words": [
    31,
    3
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 208484266,
   "revisions": [
    208484266,
    896576284
   ],
   "revision_words": [
    31,
    3
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-1",
   "section": "Difference from anti-Zionists",
   "text": "Yoram Dinstein gave this distinction: \"There is a marked difference between non-Zionism and anti-Zionism.",
   "words": 16,
   "authors": [
    "Editor 2",
    "Editor 9"
   ],
   "author_words": [
    11,
    5
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 208484266,
   "revisions": [
    208484266,
    916408526
   ],
   "revision_words": [
    11,
    5
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-2",
   "section": "Difference from anti-Zionists",
   "text": "A non-Zionist may challenge the theoretical underpinning of the concept of an 'ingathering of the exiles' in an independent Jewish State.",
   "words": 22,
   "authors": [
    "Editor 2"
   ],
   "author_words": [
    22
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 208484266,
   "revisions": [
    208484266
   ],
   "revision_words": [
    22
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-3",
   "section": "Difference from anti-Zionists",
   "text": "If Jewish, he or she will not choose to live in Israel, nor will he approve or reject the notion of other Jews living there in the Jewish State of Israel... but anti-Zionists do not find it sufficient to be dissatisfied with a decision made and implemented a long time ago.",
   "words": 52,
   "authors": [
    "Editor 2",
    "Editor 7"
   ],
   "author_words": [
    42,
    10
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 208484266,
   "revisions": [
    208484266,
    896576284,
    208485188
   ],
   "revision_words": [
    41,
    10,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-4",
   "section": "Difference from anti-Zionists",
   "text": "They are not content with a critical assessment of the situation confined to an historical (and, accordingly, a theoretical) framework.",
   "words": 20,
   "authors": [
    "Editor 2"
   ],
   "author_words": [
    20
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 208484266,
   "revisions": [
    208484266
   ],
   "revision_words": [
    20
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-5",
   "section": "Difference from anti-Zionists",
   "text": "Not merely do they have an adverse opinion about the establishment of Israel in the past, but they contest the legitimacy of Israel as a State in the present time and the future.\"",
   "words": 33,
   "authors": [
    "Editor 2"
   ],
   "author_words": [
    33
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 208484266,
   "revisions": [
    208484266
   ],
   "revision_words": [
    33
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec3-1",
   "section": "Non-position",
   "text": "Non-Zionism has also been defined in terms of a non-position on Zionism.",
   "words": 14,
   "authors": [
    "Editor 4"
   ],
   "author_words": [
    14
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 311191465,
   "revisions": [
    311191465
   ],
   "revision_words": [
    14
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec3-2",
   "section": "Non-position",
   "text": "Anthony Frosh has defined a non-Zionist Jew as a Jew \"who does not have any particular political relationship (positive or negative) with the State of Israel, or at least little more of a relationship than they would have with some other 3rd party state.\"",
   "words": 45,
   "authors": [
    "Editor 4",
    "Editor 13",
    "Editor 19"
   ],
   "author_words": [
    42,
    2,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 311191465,
   "revisions": [
    311191465,
    952544005,
    1219262245
   ],
   "revision_words": [
    42,
    2,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec4-1",
   "section": "Haredi non-Zionism",
   "text": "Generally, those groups of Ashkenazi (Western) Haredi Jews who participate in the Israeli government but do not believe in religious Zionism are known as \"non-Zionists\".",
   "words": 26,
   "authors": [
    "Editor 3",
    "Editor 5",
    "Editor 18"
   ],
   "author_words": [
    22,
    3,
    1
   ],
   "author_sanctioned": true,
   "sanctioned_words": 1,
   "added_revision": 428119775,
   "revisions": [
    428119775,
    428907657,
    428917541,
    1203360019
   ],
   "revision_words": [
    22,
    2,
    1,
    1
   ],
   "added_before_sanction": true,
   "sanctioned_words_before": 1,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec4-2",
   "section": "Haredi non-Zionism",
   "text": "The most prominent non-Zionist Haredi group is Agudath Israel.",
   "words": 10,
   "authors": [
    "Editor 3"
   ],
   "author_words": [
    10
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 428119775,
   "revisions": [
    428119775
   ],
   "revision_words": [
    10
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec4-3",
   "section": "Haredi non-Zionism",
   "text": "This is in contrast to the religious Zionist Mizrachi party (which believed the State of Israel to be the beginning of the redemption); and also in contrast to the anti-Zionist Haredi groups, such as Satmar, Neturei Karta, and Edah HaChareidis, that openly oppose Zionism and have little to no interaction with the State of Israel and no representation in its government.",
   "words": 62,
   "authors": [
    "Editor 3",
    "Editor 11",
    "Editor 12",
    "Editor 17"
   ],
   "author_words": [
    56,
    3,
    2,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 428119775,
   "revisions": [
    428119775,
    1146324710,
    909641773,
    936309860
   ],
   "revision_words": [
    56,
    3,
    2,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec4-4",
   "section": "Haredi non-Zionism",
   "text": "Unlike the older definition, many live in the State of Israel.",
   "words": 11,
   "authors": [
    "Editor 5"
   ],
   "author_words": [
    11
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 428907657,
   "revisions": [
    428907657
   ],
   "revision_words": [
    11
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec4-5",
   "section": "Haredi non-Zionism",
   "text": "They tend to be extremely pro-Israel politically, as can be seen in such publications as Mishpacha and Hamodia.",
   "words": 19,
   "authors": [
    "Editor 5"
   ],
   "author_words": [
    19
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 428907657,
   "revisions": [
    428907657
   ],
   "revision_words": [
    19
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec4-6",
   "section": "Haredi non-Zionism",
   "text": "Sephardi Haredi Jews may refer to themselves as Zionist.",
   "words": 9,
   "authors": [
    "Editor 5"
   ],
   "author_words": [
    9
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 428907657,
   "revisions": [
    428907657,
    428917541
   ],
   "revision_words": [
    8,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec5-1",
   "section": "Simon Dubnow's Non-Zionism, or \"Folkism\"",
   "text": "Simon Dubnow was a Russian-Jewish philosopher and historian of Jewish history, especially Russian and Polish Jewish history.",
   "words": 18,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    18
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1221459038,
   "revisions": [
    1221459038,
    1221477602
   ],
   "revision_words": [
    14,
    4
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec5-2",
   "section": "Simon Dubnow's Non-Zionism, or \"Folkism\"",
   "text": "Dubnow himself was somewhat ambivalent towards Zionism as a political ideology, calling it \"a beautiful, messianic dream\" and seeing the creation of a Jewish state in Palestine as improbable.",
   "words": 29,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    29
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1221459038,
   "revisions": [
    1221459038,
    1221459199
   ],
   "revision_words": [
    27,
    2
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec5-3",
   "section": "Simon Dubnow's Non-Zionism, or \"Folkism\"",
   "text": "Nonetheless, Dubnow was adamantly opposed to assimilation.",
   "words": 7,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    7
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1221460610,
   "revisions": [
    1221460610
   ],
   "revision_words": [
    7
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec5-4",
   "section": "Simon Dubnow's Non-Zionism, or \"Folkism\"",
   "text": "In his book, Weltgeschichte des jüdischen volkes, Dubnow differentiates between a political and spiritual nation, arguing that Jewish nationalism was not inherently violent, and promoting the ideal of a universal Jewish humanism, or the \"Jewish world-nation,\" as the core of his ideal.",
   "words": 43,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    43
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1221460610,
   "revisions": [
    1221460610,
    1221476697
   ],
   "revision_words": [
    39,
    4
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec5-5",
   "section": "Simon Dubnow's Non-Zionism, or \"Folkism\"",
   "text": "In seeking this ideal, the Jewish diaspora would aspire for a non-territorial autonomous status.",
   "words": 15,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    15
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1221460610,
   "revisions": [
    1221460610,
    1221476823
   ],
   "revision_words": [
    13,
    2
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec5-6",
   "section": "Simon Dubnow's Non-Zionism, or \"Folkism\"",
   "text": "This philosophy became known as \"Jewish Autonomism,\" or \"\" and was eventually adopted by the (\"Jewish People's Party\" in English), which Dubnow himself helped found, and the Bund, a socialist Jewish labor movement.",
   "words": 33,
   "authors": [
    "Editor 1",
    "Editor 8"
   ],
   "author_words": [
    26,
    7
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1221460610,
   "revisions": [
    1221460610,
    1287074140,
    1221476654,
    1221476453
   ],
   "revision_words": [
    15,
    7,
    6,
    5
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec5-7",
   "section": "Simon Dubnow's Non-Zionism, or \"Folkism\"",
   "text": "For him, any Jewish national movement should not to have a flag or a military.",
   "words": 15,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    15
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1221460610,
   "revisions": [
    1221460610,
    1221476453
   ],
   "revision_words": [
    14,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec5-8",
   "section": "Simon Dubnow's Non-Zionism, or \"Folkism\"",
   "text": "Nonetheless, he did gradually warm up to some aspects of Ahad Ha'am's vision of Cultural Zionism later in his life and viewed a return to Zion as fitting for some Jews, albeit not for all.",
   "words": 37,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    37
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1221460610,
   "revisions": [
    1221460610,
    1221477262
   ],
   "revision_words": [
    33,
    4
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec5-9",
   "section": "Simon Dubnow's Non-Zionism, or \"Folkism\"",
   "text": "Dubnow would never see the birth of the State of Israel, as he was murdered on December 8, 1941 during the march to the Rumbula forest, where the Nazi Wehrmacht and collaborators killed 25,000 Jews in the Rumbula massacre.",
   "words": 40,
   "authors": [
    "Editor 1",
    "Editor 10"
   ],
   "author_words": [
    35,
    5
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1221477262,
   "revisions": [
    1221477262,
    1298449430,
    1221477537,
    1221477339
   ],
   "revision_words": [
    30,
    5,
    4,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec5-10",
   "section": "Simon Dubnow's Non-Zionism, or \"Folkism\"",
   "text": "Nonetheless, Dubnow's histories and promotion of Jewish culture and Jewish political autonomy still earn him praise to this day within many intellectual circles.",
   "words": 24,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    24
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
