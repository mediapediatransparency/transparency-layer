 "sentences": [
  {
   "id": "lead-1",
   "section": "(lead)",
   "text": "Non-Zionism is the political stance of Jews who are \"willing to help support Jewish settlement in Palestine... but will not come on aliyah,\" writes the scholar David Polish.",
   "words": 29,
   "authors": [
    "Editor 2",
    "Editor 6",
    "Editor 14",
    "Editor 16",
    "Editor 20"
   ],
   "author_words": [
    20,
    5,
    2,
    1,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 208484266,
   "revisions": [
    208484266,
    208486118,
    1339430838,
    680482539,
    1360022064
   ],
   "revision_words": [
    20,
