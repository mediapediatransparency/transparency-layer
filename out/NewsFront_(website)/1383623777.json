   "sanctioned_words_during": 0
  },
  {
   "id": "lead-2",
   "section": "(lead)",
   "text": "According to owner Konstantin Knyrik, however, NewsFront is fighting an \"information war\" against unfair attacks on Russia.",
   "words": 17,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    17
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1075877813,
