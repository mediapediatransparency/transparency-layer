   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-1",
   "section": "Leadership and origin",
   "text": "NewsFront is published by Mediagroup Newsfront LLC, headquartered in Bakhchysarai in central Crimea, registered to the home address of local council member Konstantin Knyrik.",
   "words": 24,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
