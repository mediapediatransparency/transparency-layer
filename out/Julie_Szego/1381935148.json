   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-3",
   "section": "Career",
   "text": "Szego wrote a monthly column for The Australian Jewish News for seven years and edited her father's 2001 memoir, Two Prayers to One God.",
   "words": 25,
   "authors": [
