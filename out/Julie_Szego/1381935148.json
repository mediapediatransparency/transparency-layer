  },
  {
   "id": "sec1-2",
   "section": "Career",
   "text": "She wrote for The Age on and off for more than two decades as a social affairs reporter, senior writer, leader writer and weekly columnist, until her dismissal in 2023.",
   "words": 30,
   "authors": [
    "Editor 2",
    "Editor 6"
   ],
   "author_words": [
    25,
