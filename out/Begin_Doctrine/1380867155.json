 "sentences": [
  {
   "id": "lead-1",
   "section": "(lead)",
   "text": "The Begin Doctrine is the common term for the Israeli government's preventive strike, counter-proliferation policy regarding their potential enemies' capability to possess weapons of mass destruction (WMD), particularly nuclear weapons.",
   "words": 33,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    33
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628177126,
   "revisions": [
    628177126
   ],
   "revision_words": [
    33
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-2",
   "section": "(lead)",
   "text": "The roots of this doctrine can be tracked at least to Operation Damocles in 1962.",
   "words": 15,
   "authors": [
    "Editor 3",
    "Editor 17"
   ],
   "author_words": [
    13,
    2
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 831900528,
   "revisions": [
    831900528,
    1296757582
   ],
   "revision_words": [
    13,
    2
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-3",
   "section": "(lead)",
   "text": "Secret and diplomatic operations against the Iraqi nuclear program were started by the Yitzhak Rabin government in the mid-1970s.",
   "words": 20,
   "authors": [
    "Editor 3",
    "Editor 12",
    "Editor 13",
    "Editor 15",
    "Editor 20"
   ],
   "author_words": [
    11,
    3,
    3,
    2,
    1
   ],
   "author_sanctioned": true,
   "sanctioned_words": 3,
   "added_revision": 831900528,
   "revisions": [
    831900528,
    839175549,
    1180845076,
    839162304,
    839162383,
    1186450162
   ],
   "revision_words": [
    11,
    3,
    3,
    1,
    1,
    1
   ],
   "added_before_sanction": true,
   "sanctioned_words_before": 3,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-4",
   "section": "(lead)",
   "text": "The doctrine itself was enunciated by Israeli Prime Minister Menachem Begin in June 1981, following Israel's attack on Iraq's nuclear reactor Osirak in Operation Opera.",
   "words": 27,
   "authors": [
    "Editor 1",
    "Editor 3",
    "Editor 11",
    "Editor 4"
   ],
   "author_words": [
    19,
    3,
    3,
    2
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628177126,
   "revisions": [
    628177126,
    342098807,
    831900528,
    327572411
   ],
   "revision_words": [
    19,
    3,
    3,
    2
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-5",
   "section": "(lead)",
   "text": "The doctrine remains a feature of Israeli security planning.",
   "words": 9,
   "authors": [
    "Editor 1",
    "Editor 4"
   ],
   "author_words": [
    7,
    2
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628177126,
   "revisions": [
    628177126,
    327572411
   ],
   "revision_words": [
    7,
    2
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-6",
   "section": "(lead)",
   "text": "The initial government statement on the incident stated: \"On no account shall we permit an enemy to develop weapons of mass destruction against the people of Israel.",
   "words": 27,
   "authors": [
    "Editor 4",
    "Editor 1"
   ],
   "author_words": [
    19,
    8
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 327572411,
   "revisions": [
    327572411,
    628177126
   ],
   "revision_words": [
    19,
    8
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-7",
   "section": "(lead)",
   "text": "We shall defend the citizens of Israel in good time and with all the means at our disposal.\"",
   "words": 18,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    18
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628169070,
   "revisions": [
    628169070
   ],
   "revision_words": [
    18
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-8",
   "section": "(lead)",
   "text": "Two days after the attack in a dramatic press conference in Tel Aviv, Prime Minister Begin took full responsibility for the operation, praised its execution as extraordinary, and justified it both on moral and legal grounds.",
   "words": 36,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    36
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628184546,
   "revisions": [
    628184546
   ],
   "revision_words": [
    36
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-9",
   "section": "(lead)",
   "text": "Begin referred to the strike as an act of \"anticipatory self-defense at its best.\"",
   "words": 15,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    15
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628184546,
   "revisions": [
    628184546
   ],
   "revision_words": [
    15
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-10",
   "section": "(lead)",
   "text": "The message Begin conveyed was that the raid on Osirak was not a one-time operation, but rather a long-term national commitment.",
   "words": 23,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    23
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628184546,
   "revisions": [
    628184546
   ],
   "revision_words": [
    23
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-11",
   "section": "(lead)",
   "text": "He ended his press conference with these words:",
   "words": 8,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    8
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628184546,
   "revisions": [
    628184546
   ],
   "revision_words": [
    8
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-12",
   "section": "(lead)",
   "text": "\"We chose this moment: now, not later, because later may be too late, perhaps forever.",
   "words": 15,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    15
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628184546,
   "revisions": [
    628184546
   ],
   "revision_words": [
    15
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-13",
   "section": "(lead)",
   "text": "And if we stood by idly, two, three years, at the most four years, and Saddam Hussein would have produced his three, four, five bombs.",
   "words": 25,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    25
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628184546,
   "revisions": [
    628184546
   ],
   "revision_words": [
    25
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-14",
   "section": "(lead)",
   "text": "Then, this country and this people would have been lost, after the Holocaust.",
   "words": 13,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    13
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628184546,
   "revisions": [
    628184546
   ],
   "revision_words": [
    13
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-15",
   "section": "(lead)",
   "text": "Another Holocaust would have happened in the history of the Jewish people.",
   "words": 12,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    12
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628184546,
   "revisions": [
    628184546
   ],
   "revision_words": [
    12
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-16",
   "section": "(lead)",
   "text": "Never again, never again!",
   "words": 4,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    4
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628184546,
   "revisions": [
    628184546
   ],
   "revision_words": [
    4
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-17",
   "section": "(lead)",
   "text": "Tell so your friends, tell anyone you meet, we shall defend our people with all the means at our disposal.",
   "words": 20,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    20
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628184546,
   "revisions": [
    628184546
   ],
   "revision_words": [
    20
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-18",
   "section": "(lead)",
   "text": "We shall not allow any enemy to develop weapons of mass destruction turned against us.\"",
   "words": 15,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    15
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628184546,
   "revisions": [
    628184546
   ],
   "revision_words": [
    15
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-19",
   "section": "(lead)",
   "text": "On June 15, in a television interview on Face the Nation, Begin reiterated this doctrinal point: \"This attack will be a precedent for every future government in Israel.",
   "words": 28,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    28
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628185039,
   "revisions": [
    628185039
   ],
   "revision_words": [
    28
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-20",
   "section": "(lead)",
   "text": "Every future Israeli prime minister will act, in similar circumstances, in the same way.\"",
   "words": 14,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    14
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628185039,
   "revisions": [
    628185039
   ],
   "revision_words": [
    14
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-21",
   "section": "(lead)",
   "text": "Following the attack and Israeli government comments, many foreign powers opposed it and the United Nations Security Council unanimously passed United Nations Security Council Resolution 487 condemning the attacks.",
   "words": 29,
   "authors": [
    "Editor 5",
    "Editor 1"
   ],
   "author_words": [
    23,
    6
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 527574190,
   "revisions": [
    527574190,
    628183584
   ],
   "revision_words": [
    23,
    6
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-1",
   "section": "Operation Outside the Box",
   "text": "The Begin doctrine was followed in 2007 under Prime Minister Ehud Olmert with Operation Outside the Box against a Syrian nuclear facility.",
   "words": 22,
   "authors": [
    "Editor 1",
    "Editor 9",
    "Editor 4"
   ],
   "author_words": [
    16,
    5,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628181508,
   "revisions": [
    628181508,
    844935736,
    327572411,
    628189871
   ],
   "revision_words": [
    15,
    5,
    1,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-2",
   "section": "Operation Outside the Box",
   "text": "What was particularly notable about the attack on Syria was what occurred in its aftermath, the near total lack of international comment or criticism of Israel's action.",
   "words": 28,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    28
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628189871,
   "revisions": [
    628189871
   ],
   "revision_words": [
    28
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-3",
   "section": "Operation Outside the Box",
   "text": "This lack of reaction contrasted starkly to the international outcry that followed Israel's preventive strike in 1981 against Iraq's reactor.",
   "words": 22,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    22
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628189871,
   "revisions": [
    628189871
   ],
   "revision_words": [
    22
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-4",
   "section": "Operation Outside the Box",
   "text": "Foreign governments may have reserved comment because of the lack of information after the attack, but the Israeli government imposed a virtually total news blackout immediately after the raid that lasted for seven months.",
   "words": 34,
   "authors": [
    "Editor 1",
    "Editor 6"
   ],
   "author_words": [
    33,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628189871,
   "revisions": [
    628189871,
    980782587
   ],
   "revision_words": [
    33,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-5",
   "section": "Operation Outside the Box",
   "text": "The U.S. government ordered officials with knowledge of the attack to keep it confidential.",
   "words": 15,
   "authors": [
    "Editor 6"
   ],
   "author_words": [
    15
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 980782587,
   "revisions": [
    980782587
   ],
   "revision_words": [
    15
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-6",
   "section": "Operation Outside the Box",
   "text": "Syria was initially silent on the matter and then subsequently denied that the bombed target was a nuclear facility.",
   "words": 19,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    19
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628189871,
   "revisions": [
    628189871
   ],
   "revision_words": [
    19
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-7",
   "section": "Operation Outside the Box",
   "text": "The international silence continued even after the CIA made information public in April 2008.",
   "words": 14,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    14
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 628189871,
   "revisions": [
    628189871
   ],
   "revision_words": [
    14
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
