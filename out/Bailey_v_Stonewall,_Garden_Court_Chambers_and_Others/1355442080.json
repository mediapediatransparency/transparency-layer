    1,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-2",
   "section": "(lead)",
   "text": "The Employment Appeal Tribunal ruled that Garden Court Chambers had discriminated against her in concluding that two of her personal tweets potentially breached her core duties as a barrister and awarded £22,000 in damages, but dismissed all other claims with regards to lost income or work opportunities due to the complaint.",
   "words": 52,
   "authors": [
    "Editor 3",
    "Editor 13",
    "Editor 4"
   ],
   "author_words": [
    48,
    3,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1262126126,
   "revisions": [
    1262126126,
    1156180083,
    1262471287
   ],
   "revision_words": [
    48,
    3,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-3",
   "section": "(lead)",
   "text": "The Tribunal also dismissed all of her claims against Stonewall.",
   "words": 10,
   "authors": [
    "Editor 3"
   ],
   "author_words": [
    10
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1262126126,
   "revisions": [
    1262126126
   ],
   "revision_words": [
    10
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-4",
   "section": "(lead)",
   "text": "Bailey unsuccessfully appealed the claim against Stonewall at the Employment Appeal Tribunal, with the appeal being dismissed in July 2024.",
   "words": 20,
   "authors": [
    "Editor 9",
    "Editor 3",
    "Editor 12",
    "Editor 4"
   ],
   "author_words": [
    8,
    7,
    3,
    2
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1262449892,
   "revisions": [
    1262449892,
    1262141044,
    1262126417,
    1262470982
   ],
   "revision_words": [
