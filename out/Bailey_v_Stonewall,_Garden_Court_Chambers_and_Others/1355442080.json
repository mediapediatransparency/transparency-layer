   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-5",
   "section": "(lead)",
   "text": "Bailey unsuccessfully appealed the claim at the Court of Appeal, with the appeal being dismissed in December 2025.",
   "words": 18,
   "authors": [
