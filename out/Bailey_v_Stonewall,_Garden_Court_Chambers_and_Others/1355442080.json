 "sentences": [
  {
   "id": "lead-1",
   "section": "(lead)",
   "text": "Bailey v Stonewall, Garden Court Chambers and others is a UK discrimination case in 2022 brought by Allison Bailey against her chambers Garden Court Chambers and Stonewall.",
   "words": 27,
   "authors": [
    "Editor 3",
    "Editor 6",
    "Editor 4",
    "Editor 15"
   ],
   "author_words": [
    17,
    6,
    3,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1262126126,
   "revisions": [
    1262126126,
    1014024863,
    1051494126,
    1263588939,
    1051581783,
    1104055402
   ],
   "revision_words": [
    17,
    3,
    3,
