  {
   "id": "lead-5",
   "section": "(lead)",
   "text": "She is the oldest president to have ever served in office and also holds the record for receiving the highest number of votes in a parliamentary presidential election.",
   "words": 28,
   "authors": [
    "Editor 3"
   ],
   "author_words": [
    28
   ],
   "author_sanctioned": false,
