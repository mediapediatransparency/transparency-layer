   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-2",
   "section": "Career",
   "text": "She has spent her professional career in financial and educational institutions, as well as leading various NGOs in the country.",
   "words": 20,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    20
   ],
   "author_sanctioned": false,
