  },
  {
   "id": "sec1-1",
   "section": "Education",
   "text": "Pula graduated with a degree in economics from the University of Pristina in 1976, and graduated in the theory and politics of development economics in 1984 from the University of Zagreb.",
   "words": 31,
   "authors": [
    "Editor 1",
    "Editor 5"
   ],
   "author_words": [
    30,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
