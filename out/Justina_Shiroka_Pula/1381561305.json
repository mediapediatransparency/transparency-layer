   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-3",
   "section": "Career",
   "text": "Between 2002 and 2008, she chaired the Board of Directors of the Kosovar Civil Society Foundation.",
   "words": 16,
   "authors": [
