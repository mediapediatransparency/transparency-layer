   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-2",
   "section": "Education",
   "text": "In 1977, Pula obtained her PhD from the Faculty of Economics in Pristina with a thesis entitled Demographic Investments and Economic Development of Kosovo.",
   "words": 24,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    24
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
