   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-1",
   "section": "Career",
   "text": "She began working at the Central Bank of Kosovo after graduating, and has been a lecturer at the Faculty of Economics at the University of Pristina since 1978.",
   "words": 28,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    28
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1357766331,
   "revisions": [
