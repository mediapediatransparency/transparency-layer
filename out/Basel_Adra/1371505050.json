  {
   "id": "sec3-1",
   "section": "Personal life",
   "text": "Adra was born to father Nasser in At-Tuwani, Hebron Municipality, in the West Bank of Palestine.",
   "words": 17,
   "authors": [
    "Editor 3"
   ],
   "author_words": [
    17
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1087370789,
   "revisions": [
