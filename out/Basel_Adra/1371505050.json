   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec3-3",
   "section": "Personal life",
   "text": "Adra married in 2024 and has a daughter.",
   "words": 8,
   "authors": [
    "Editor 14",
    "Editor 5"
   ],
   "author_words": [
    7,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1277563935,
   "revisions": [
    1277563935,
    1273114289
   ],
   "revision_words": [
