   "sanctioned_words_during": 0
  },
  {
   "id": "lead-6",
   "section": "(lead)",
   "text": "In 2025, the film won the Academy Award for Best Documentary Feature Film, making Adra the first Palestinian filmmaker to win an Oscar.",
   "words": 23,
   "authors": [
    "Editor 12",
    "Editor 5"
   ],
   "author_words": [
    13,
    10
   ],
   "author_sanctioned": false,
