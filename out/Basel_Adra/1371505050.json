   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-2",
   "section": "No Other Land",
   "text": "The film won the Best Documentary Feature Film category at the 97th Academy Awards.",
   "words": 14,
   "authors": [
    "Editor 5",
    "Editor 15"
   ],
   "author_words": [
    7,
