   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec3-2",
   "section": "Personal life",
   "text": "He lives in Masafer Yatta, Hebron.",
   "words": 6,
   "authors": [
    "Editor 3"
   ],
   "author_words": [
    6
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1087364789,
   "revisions": [
    1087364789,
    1087370789,
    1087371276
   ],
   "revision_words": [
