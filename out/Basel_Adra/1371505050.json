    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec3-4",
   "section": "Personal life",
   "text": "On 3 February 2025, Adra was attacked by masked Israeli settler extremists in Masafer Yatta.",
   "words": 15,
   "authors": [
    "Editor 11"
   ],
   "author_words": [
    15
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1273909729,
   "revisions": [
    1273909729
   ],
   "revision_words": [
    15
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec3-5",
   "section": "Personal life",
   "text": "On March 24, 2025, after No Other Land co-director Hamdan Ballal was also attacked by Israeli settlers, Adra said: \"We came back from the Oscars and every day since there is an attack on us.",
   "words": 36,
   "authors": [
    "Editor 2"
   ],
   "author_words": [
    36
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1282197413,
   "revisions": [
    1282197413
   ],
   "revision_words": [
    36
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec3-6",
   "section": "Personal life",
   "text": "This might be their revenge on us for making the movie.",
   "words": 11,
   "authors": [
    "Editor 2"
   ],
   "author_words": [
    11
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1282197413,
   "revisions": [
    1282197413
   ],
   "revision_words": [
    11
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec3-7",
   "section": "Personal life",
   "text": "It feels like a punishment.\"",
   "words": 5,
   "authors": [
    "Editor 2"
   ],
   "author_words": [
    5
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1282197413,
   "revisions": [
    1282197413
   ],
   "revision_words": [
    5
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec3-8",
   "section": "Personal life",
   "text": "On 13 September 2025, a group of Israeli settlers, from the illegal Havat Ma'on outpost, attacked Adra's village, injuring three family members and a foreign activist.",
   "words": 28,
   "authors": [
    "Editor 10",
    "Editor 2"
   ],
   "author_words": [
    16,
    12
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1311573073,
   "revisions": [
    1311573073,
    1311709582
   ],
   "revision_words": [
    16,
    12
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec3-9",
   "section": "Personal life",
   "text": "Israeli soldiers at the scene did not intervene during the attack, and while Adra accompanied the injured to the hospital, nine Israeli soldiers raided his home.",
   "words": 26,
   "authors": [
    "Editor 2"
   ],
   "author_words": [
    26
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1311709582,
   "revisions": [
    1311709582
   ],
   "revision_words": [
    26
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec3-10",
   "section": "Personal life",
   "text": "The soldiers searched through his wife's phone, detained one of his uncles, and blocked At-Tuwani's entrance, preventing Adra from returning home.",
   "words": 24,
   "authors": [
    "Editor 2"
   ],
   "author_words": [
    24
   ],
