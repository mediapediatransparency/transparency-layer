   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-4",
   "section": "(lead)",
   "text": "The film captures the plight of the besieged community of Masafer Yatta, where Adra was raised, showing Israeli forces demolishing homes and forcibly removing families who have lived there for generations, claiming the land for military training purposes.",
   "words": 38,
   "authors": [
    "Editor 4"
   ],
   "author_words": [
    38
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1278130389,
   "revisions": [
    1278130389,
    1277961234
   ],
   "revision_words": [
    30,
    8
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-5",
   "section": "(lead)",
   "text": "It premiered at the 74th Berlin International Film Festival and won the Panorama Audience Award for Best Documentary Film and the Berlinale Documentary Film Award.",
   "words": 25,
   "authors": [
    "Editor 8",
    "Editor 7",
    "Editor 1",
    "Editor 4"
   ],
   "author_words": [
    15,
