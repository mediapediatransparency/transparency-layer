   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-8",
   "section": "Books",
   "text": "The website summary reads, \"Who Hunts the Whale is a completely fictional, entirely made-up novel set in the imaginary world of the video gaming industry.",
   "words": 26,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
