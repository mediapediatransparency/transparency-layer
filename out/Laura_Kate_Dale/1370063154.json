   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-5",
   "section": "Books",
   "text": "It was intended as a counterpoint to the focus so often placed on the negative aspects of being trans, such as gender dysphoria, and was instead written \"to show the world the sheer variety of ways being non cisgender can be a beautiful, joyful experience\".",
   "words": 45,
