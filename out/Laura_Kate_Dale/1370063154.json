   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec3-2",
   "section": "Activism",
   "text": "The protest featured a roster of speakers including prominent UK trans activists such as Fox Fisher and Roz Kaveney as well as Dale herself, and was attended by the British human rights campaigner Peter Tatchell.",
   "words": 35,
   "authors": [
    "Editor 2"
   ],
   "author_words": [
