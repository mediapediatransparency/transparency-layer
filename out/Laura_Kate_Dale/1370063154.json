  {
   "id": "sec3-1",
   "section": "Activism",
   "text": "Dale collaborated with former founder of the Trans Rights Collective UK (disbanded in 2020), Felix Fern, in 2021 to co-organise a 'trans rights' protest outside Downing Street in London on 6 August 2021, calling on the government to implement better rights and equality for transgender and non-binary people in the United Kingdom.",
   "words": 54,
   "authors": [
    "Editor 2",
    "Editor 18"
   ],
   "author_words": [
    53,
    1
   ],
   "author_sanctioned": false,
