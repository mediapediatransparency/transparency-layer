   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-4",
   "section": "Books",
   "text": "Her third book, Gender Euphoria: Stories of Joy from Trans, Non-Binary and Intersex Writers, which was crowdfunded through Unbound and exceeded its funding goal, was published in 2021.",
   "words": 29,
   "authors": [
    "Editor 6",
    "Editor 1"
   ],
   "author_words": [
    15,
