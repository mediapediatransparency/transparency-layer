   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-3",
   "section": "Books",
   "text": "Her second book, a memoir called Uncomfortable Labels: My Life as a Gay Autistic Trans Woman, was published by Jessica Kingsley Publishers in 2019.",
   "words": 24,
