   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-9",
   "section": "Books",
   "text": "Written with a gamer's wit and an insider's precision, it holds the real-world business up to a carnival house of mirrors, to give a satirical look at the human cost of a rapacious market that must constantly be fed new content.\"",
   "words": 44,
   "authors": [
