   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec4-5",
   "section": "Controversies",
   "text": "Maciak was the only candidate not invited to all 3 debates hosted by TV Republika, whose host, Katarzyna Gójska, stated \"The Home of Free Speech will never be a place for a fan of a genocidist and a man who directed threats against us\".",
   "words": 44,
   "authors": [
    "Editor 2"
   ],
   "author_words": [
