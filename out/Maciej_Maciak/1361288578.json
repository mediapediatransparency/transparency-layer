   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-14",
   "section": "Biography",
   "text": "Since the start of the campaign, he was considered one of the more recognizable candidates from outside the major political organizations.",
   "words": 21,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    21
   ],
   "author_sanctioned": false,
