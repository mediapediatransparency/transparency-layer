   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec2-5",
   "section": "Views",
   "text": "Maciak admires the President of Russia, Vladimir Putin.",
   "words": 8,
   "authors": [
