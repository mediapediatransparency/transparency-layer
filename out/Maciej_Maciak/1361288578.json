   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-7",
   "section": "Biography",
   "text": "In 2018, he ran for President of Włocławek along a slate of candidates supportive of him to the city council, which secured 7.80% of the vote and no seats, whereas he himself received 14.13% of the vote.",
   "words": 39,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
