  {
   "id": "sec1-10",
   "section": "Biography",
   "text": "He declared his candidacy in the 2025 Polish presidential election.",
   "words": 10,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    10
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
