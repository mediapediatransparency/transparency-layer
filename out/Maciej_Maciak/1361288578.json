   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-15",
   "section": "Biography",
   "text": "His name recognition was further expanded after appearing at the TVP debate on 11 April.",
   "words": 15,
   "authors": [
