   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-11",
   "section": "Biography",
   "text": "Maciak's first big political success was registering the Prosperity and Peace Movement to the 2023 Polish parliamentary election, where the movement won 24,850 votes (0.12%), coming ahead of the Normal Country, \"Anti-party\" and Repair Poland Movement parties in the Sejm and 20,672 votes (0.10%) in the Senat.",
   "words": 53,
   "authors": [
    "Editor 1",
    "Editor 10"
   ],
   "author_words": [
    52,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1271762796,
   "revisions": [
    1271762796,
    1285256632,
    1273967761
   ],
   "revision_words": [
    50,
    2,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-12",
   "section": "Biography",
   "text": "He was the party's candidate for poseł in the Sejm Constituency no. 5 with the number 8 on its lists, and personally received 1,298 votes (0.24%), whereas his party in the constituency received 2,266 (0.42%).",
   "words": 40,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    40
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1271762796,
   "revisions": [
    1271762796
   ],
   "revision_words": [
    40
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-13",
   "section": "Biography",
   "text": "He announced his start in the 2025 presidential election, successfully registering with 100,000 signatures.",
   "words": 15,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    15
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
