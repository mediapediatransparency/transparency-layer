  },
  {
   "id": "sec1-5",
   "section": "Biography",
   "text": "In 2006, 36-year-old Maciak contested the election for the Kuyavian–Pomeranian Voivodeship Sejmik for Self-Defence of the Republic of Poland, where he won 500 votes.",
   "words": 28,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    28
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1271762796,
   "revisions": [
