  },
  {
   "id": "sec4-2",
   "section": "Controversies",
   "text": "On April 30, 2025, Maciak was invited to an interview by Krzysztof Stanowski on Kanał Zero.",
   "words": 16,
   "authors": [
    "Editor 1",
    "Editor 3"
   ],
   "author_words": [
    9,
    7
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1288404627,
   "revisions": [
