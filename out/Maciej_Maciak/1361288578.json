    7
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec4-3",
   "section": "Controversies",
   "text": "Within two minutes of the start of the interview, Stanowski left, stating he did not wish to provide a platform for such views, leaving Maciak alone in the studio, who left a few minutes later.",
   "words": 35,
   "authors": [
    "Editor 3",
    "Editor 1"
   ],
   "author_words": [
    18,
    17
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1288398484,
   "revisions": [
    1288398484,
    1288404627
   ],
   "revision_words": [
    18,
    17
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec4-4",
   "section": "Controversies",
   "text": "The incident garnered significant media attention and sparked discussions regarding the boundaries of acceptable discourse in political interviews.",
   "words": 18,
   "authors": [
    "Editor 3"
   ],
   "author_words": [
    18
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1288398484,
   "revisions": [
    1288398484
   ],
   "revision_words": [
