  {
   "id": "sec1-1",
   "section": "Biography",
   "text": "Maciak was born in Włocławek and is tied with local media.",
   "words": 11,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    11
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1271762796,
