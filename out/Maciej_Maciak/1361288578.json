   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-2",
   "section": "Biography",
   "text": "Since 2009, for 10 years he directed the local television \"CW 24tv\".",
   "words": 12,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    12
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1271762796,
   "revisions": [
    1271762796
   ],
   "revision_words": [
    12
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-3",
   "section": "Biography",
   "text": "Afterwards, he started the YouTube channel \"Musisz to wiedzieć\", which by the time of his presidential campaign reached 67,000 subscribers.",
   "words": 21,
   "authors": [
    "Editor 1",
    "Editor 11"
   ],
   "author_words": [
