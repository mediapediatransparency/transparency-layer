   ],
   "revision_words": [
    12,
    10
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "lead-9",
   "section": "(lead)",
   "text": "The studio continued to develop the Gears franchise in collaboration with other developers, including upcoming Gears of War: E-Day (2026).",
   "words": 21,
   "authors": [
    "Editor 2",
    "Editor 1"
   ],
   "author_words": [
    17,
    4
   ],
