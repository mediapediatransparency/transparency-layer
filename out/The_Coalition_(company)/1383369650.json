  },
  {
   "id": "lead-5",
   "section": "(lead)",
   "text": "Later that year, in November, Microsoft Game Studios Vancouver was rebranded as Black Tusk Studios to develop a new game.",
   "words": 20,
   "authors": [
    "Editor 1",
    "Editor 2"
   ],
   "author_words": [
