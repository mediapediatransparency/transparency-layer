   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-1",
   "section": "History",
   "text": "Microsoft established the company as Zipline Studios in February 2010.",
   "words": 10,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    10
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1229374217,
   "revisions": [
    1229374217
   ],
   "revision_words": [
    10
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-2",
   "section": "History",
   "text": "The following year, Zipline released the Facebook game Relic Rescue and was renamed Microsoft Game Studios Vancouver.",
   "words": 17,
   "authors": [
    "Editor 1",
    "Editor 4",
    "Editor 9"
   ],
   "author_words": [
    11,
    5,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1229374217,
   "revisions": [
    1229374217,
    743977123,
    706924815
   ],
   "revision_words": [
    11,
    5,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-3",
   "section": "History",
   "text": "In February 2012, the studio released the flight simulator Microsoft Flight to mixed reviews.",
   "words": 14,
   "authors": [
    "Editor 1",
    "Editor 9"
   ],
   "author_words": [
    12,
    2
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1229374217,
   "revisions": [
    1229374217,
    706924815
   ],
   "revision_words": [
    12,
    2
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-4",
   "section": "History",
   "text": "Citing a need to realign the company's long-term goals and development plans, Microsoft ended continued development of Microsoft Flight in July 2012.",
   "words": 24,
   "authors": [
    "Editor 1",
    "Editor 2",
    "Editor 9"
   ],
   "author_words": [
    16,
    7,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1229374217,
   "revisions": [
    1229374217,
    1373106578,
    706924815
   ],
   "revision_words": [
    16,
    7,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-5",
   "section": "History",
   "text": "This decision coincided with the cancellation of Project Columbia, an unannounced Kinect shooter game, and the layoff of all 35 employees.",
   "words": 21,
   "authors": [
    "Editor 1",
    "Editor 4"
   ],
   "author_words": [
    18,
    3
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1229374217,
   "revisions": [
    1229374217,
    743997635,
    1229377333
   ],
   "revision_words": [
    17,
    3,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-6",
   "section": "History",
   "text": "In November, Microsoft Game Studios Vancouver was rebranded as Black Tusk Studios and tasked with developing a major franchise for Microsoft Studios, comparable to its Halo franchise.",
   "words": 27,
   "authors": [
    "Editor 5",
    "Editor 1",
    "Editor 10",
    "Editor 4",
    "Editor 17"
   ],
   "author_words": [
    11,
    10,
    3,
    2,
    1
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 533334101,
   "revisions": [
    533334101,
    1229374217,
    665354652,
    743977123,
    743990189,
    1348326318
   ],
   "revision_words": [
    11,
    10,
    3,
    1,
    1,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-7",
   "section": "History",
   "text": "In 2014, Microsoft acquired the rights to the franchise Gears of War from Epic Games and the developers in-development game was canceled in favor of developing a new title in the franchise.",
   "words": 33,
   "authors": [
    "Editor 2",
    "Editor 7",
    "Editor 1"
   ],
   "author_words": [
    15,
    13,
    5
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1373108594,
   "revisions": [
    1373108594,
    592642547,
    1229374217
   ],
   "revision_words": [
    15,
    13,
    5
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-8",
   "section": "History",
   "text": "Rod Fergusson, who had been the producer of the franchise at Epic, became the head of the studio.",
   "words": 18,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    18
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1229374217,
   "revisions": [
    1229374217,
    1229375041
   ],
   "revision_words": [
    17,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-9",
   "section": "History",
   "text": "Black Tusk was renamed The Coalition—a reference to an entity within the Gears of War franchise, the Coalition of Ordered Governments—in June 2015.",
   "words": 25,
   "authors": [
    "Editor 6",
    "Editor 1",
    "Editor 8",
    "Editor 10"
   ],
   "author_words": [
    14,
    7,
    2,
    2
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 810239083,
   "revisions": [
    810239083,
    1229374217,
    726907443,
    665349472,
    665354652,
    725341058
   ],
   "revision_words": [
    8,
    7,
    5,
    2,
    2,
    1
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-10",
   "section": "History",
   "text": "Two months later, the studio released Gears of War: Ultimate Edition, a remaster of the original Gears of War (2006), which was generally well-received by critics.",
   "words": 27,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    27
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1229374217,
   "revisions": [
    1229374217
   ],
   "revision_words": [
    27
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-11",
   "section": "History",
   "text": "Shortly before the release of Ultimate Edition, The Coalition announced Gears of War 4. Released in 2016, the game received favorable reviews and was nominated for best action game of the year at both the D.I.C.E.",
   "words": 39,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    39
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1229374217,
   "revisions": [
    1229374217
   ],
   "revision_words": [
    39
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-12",
   "section": "History",
   "text": "Awards and The Game Awards.",
   "words": 5,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    5
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1229374217,
   "revisions": [
    1229374217
   ],
   "revision_words": [
    5
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-13",
   "section": "History",
   "text": "The Coalition then collaborated with Mediatonic to develop the real-time strategy Gears Pop!, released in August 2019 to mixed reviews.",
   "words": 21,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    21
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1229374217,
   "revisions": [
    1229374217
   ],
   "revision_words": [
    21
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-14",
   "section": "History",
   "text": "The following month, the studio released Gears 5. The game was met with positive reviews and received several award nominations, including Xbox Game of the Year at the Golden Joystick Awards, which it won.",
   "words": 34,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    34
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1229374217,
   "revisions": [
    1229374217
   ],
   "revision_words": [
    34
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-15",
   "section": "History",
   "text": "In March 2020, Fergusson left his position to join Blizzard Entertainment, and director of operations Mike Crump assumed the role.",
   "words": 20,
   "authors": [
    "Editor 1",
    "Editor 13"
   ],
   "author_words": [
    18,
    2
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1229374217,
   "revisions": [
    1229374217,
    939365090
   ],
   "revision_words": [
    18,
    2
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-16",
   "section": "History",
   "text": "The studio collaborated with Splash Damage to develop the turn-based tactics Gears Tactics, which was released in April and met with positive critical reception.",
   "words": 25,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    25
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1229423177,
   "revisions": [
    1229423177,
    1229374217
   ],
   "revision_words": [
    20,
    5
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-17",
   "section": "History",
   "text": "Later that year, in December, The Coalition released Gears 5: Hivebusters, a downloadable expansion pack which also received positive reviews.",
   "words": 20,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    20
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1229374217,
   "revisions": [
    1229374217
   ],
   "revision_words": [
    20
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-18",
   "section": "History",
   "text": "In May 2021, the studio announced its transition to the Unreal Engine 5 game engine for future projects.",
   "words": 18,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    18
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1229374217,
   "revisions": [
    1229374217
   ],
   "revision_words": [
    18
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-19",
   "section": "History",
   "text": "The Coalition supported 343 Industries in the development of Halo Infinite and contributed to the Xbox Series X/S optimization of a tech demo The Matrix Awakens, both released in December.",
   "words": 31,
   "authors": [
    "Editor 1",
    "Editor 11",
    "Editor 3"
   ],
   "author_words": [
    24,
    4,
    3
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1229374217,
   "revisions": [
    1229374217,
    996273659,
    1294551388
   ],
   "revision_words": [
    24,
    4,
    3
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-20",
   "section": "History",
   "text": "In 2023, Microsoft conducted widespread layoffs that resulted in a reduction of staff at the studio.",
   "words": 16,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    16
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1229374217,
   "revisions": [
    1229374217
   ],
   "revision_words": [
    16
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-21",
   "section": "History",
   "text": "Gears of War: Reloaded, a remastered version of the original game, was released in August 2025 and co-developed by The Coalition, Sumo Digital, and Disbelief.",
   "words": 26,
   "authors": [
    "Editor 3",
    "Editor 1",
    "Editor 14"
   ],
   "author_words": [
    13,
    11,
    2
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1229374217,
   "revisions": [
    1229374217,
    1294704813,
    1280855765,
    1347394094
   ],
   "revision_words": [
    11,
    11,
    2,
    2
   ],
   "added_before_sanction": null,
   "sanctioned_words_before": 0,
   "sanctioned_words_after": 0,
   "sanctioned_words_during": 0
  },
  {
   "id": "sec1-22",
   "section": "History",
   "text": "The studio also collaborated with People Can Fly on Gears of War: E-Day, a prequel released in 2026, coinciding with the series' 20th anniversary.",
   "words": 25,
   "authors": [
    "Editor 3",
    "Editor 15"
   ],
   "author_words": [
    23,
    2
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1294704813,
   "revisions": [
    1294704813,
    1280855765,
    1383369650
   ],
   "revision_words": [
    20,
    3,
    2
   ],
   "added_before_sanction": null,
