  },
  {
   "id": "lead-4",
   "section": "(lead)",
   "text": "In February 2012, the studio released the flight simulator Microsoft Flight.",
   "words": 11,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    11
   ],
