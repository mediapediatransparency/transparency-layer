  },
  {
   "id": "sec1-2",
   "section": "Education",
   "text": "In 2023, he enrolled in New York University's Arthur L. Carter Journalism Institute.",
   "words": 14,
   "authors": [
    "Editor 1"
   ],
   "author_words": [
    14
   ],
   "author_sanctioned": false,
   "sanctioned_words": 0,
   "added_revision": 1343715047,
   "revisions": [
